# Large media files - never commit these
*.mov
*.MOV
*.mp4
*.MP4
*.avi
*.AVI
*.mkv
*.MKV
*.webm
*.WEBM

# Large images
*.psd
*.PSD

# Specific directories that might contain large files
static/images/*.mov
static/images/*.mp4
static/videos/
public/images/*.mov
public/images/*.mp4
public/videos/

# Hugo's public directory (generated files, shouldn't be committed anyway)
public/
resources/_gen/
