    &lt;span id=&#34;toc-icon&#34;&gt;☰&lt;/span&gt; Contents
  &lt;/button&gt;
  &lt;div id=&#34;toc-content&#34; class=&#34;toc-content&#34;&gt;
    &lt;h3 class=&#34;text-sm font-bold mb-3 text-neutral-900 dark:text-neutral&#34;&gt;On this page&lt;/h3&gt;
    &lt;nav id=&#34;toc-nav&#34;&gt;
      
      
      &lt;ul id=&#34;toc-list&#34;&gt;&lt;/ul&gt;
      
    &lt;/nav&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;style&gt;
.floating-toc {
  position: fixed;
  right: 2rem;
  top: 120px;
  width: 280px;
  z-index: 0;
  background: rgba(255, 255, 255, 0.5);
