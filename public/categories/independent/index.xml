    <item>
      <title>as long as you promise not to make me do anything about the result</title>
      <link>http://localhost:1313/projects/video/eyes/</link>
      <pubDate>Mon, 23 Jun 2025 00:00:00 +0000</pubDate>
      
      <guid>http://localhost:1313/projects/video/eyes/</guid>
      <description>&lt;p&gt;&lt;div class=&#34;vimeo-responsive &#34; style=&#34;margin: 2rem 0;&#34;&gt;
  &lt;iframe src=&#34;https://player.vimeo.com/video/1104709788?responsive=1&#34;
          frameborder=&#34;0&#34;
          allow=&#34;autoplay; fullscreen; picture-in-picture&#34;
          allowfullscreen&gt;
  &lt;/iframe&gt;
