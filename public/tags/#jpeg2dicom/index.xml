  padding-bottom: 177.78%;
  max-width: 450px;
  margin: 2rem auto;
}

.vimeo-responsive.square {
  padding-bottom: 100%;
  max-width: 600px;
  margin: 2rem auto;
}

@media (max-width: 768px) {
  .vimeo-responsive.portrait,
  .vimeo-responsive.square {
    max-width: 90%;
  }
}
