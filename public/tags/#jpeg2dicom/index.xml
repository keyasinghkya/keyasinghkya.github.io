      <guid>http://localhost:1313/projects/video/1964-2020/</guid>
      <description>&lt;p&gt;&lt;div class=&#34;vimeo-responsive &#34; style=&#34;margin: 2rem 0;&#34;&gt;
  &lt;iframe src=&#34;https://player.vimeo.com/video/493459269?responsive=1&#34;
          frameborder=&#34;0&#34;
          allow=&#34;autoplay; fullscreen; picture-in-picture&#34;
          allowfullscreen&gt;
  &lt;/iframe&gt;
&lt;/div&gt;

&lt;style&gt;
.vimeo-responsive {
  position: relative;
  padding-bottom: 56.25%;
  height: 0;
  overflow: hidden;
  max-width: 1067px;
  margin: 2rem auto;
}

.vimeo-responsive iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

