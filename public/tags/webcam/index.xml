      <description>&lt;p&gt;&lt;div style=&#34;position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; overflow: hidden;&#34;&gt;
  &lt;img src=&#34;http://localhost:1313/backgrounds/spotlight-bg.jpeg&#34; style=&#34;width: 100%; height: 100%; object-fit: cover; object-position: center top;&#34;&gt;
  &lt;div class=&#34;project-bg-overlay&#34;&gt;&lt;/div&gt;
&lt;/div&gt;

&lt;style&gt;
.project-bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.5);
}

.dark .project-bg-overlay {
  background: rgba(0, 0, 0, 0.6);
